# LLM provider: auto | ollama | groq | huggingface
# auto = Groq if GROQ_API_KEY exists, else Hugging Face if HF_TOKEN exists, else Ollama.
LLM_PROVIDER=auto
DATA_PATH=data/support_tickets.csv

# ---------------- Ollama (local, recommended for a zero-cost local run) ----------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_STRUCTURED_OUTPUT=true

# ---------------- Optional cloud free-tier providers ----------------
# Groq: requires a GROQ_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face Inference API: requires an HF_TOKEN.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
